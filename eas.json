{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "EXPO_PUBLIC_API_URL": "https://www.infosensetechnologies.com/digitalhouse/backend/api",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "457331615949-83vqrhtgb8o67mekio6e7f3hiphiaulc.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "457331615949-80vm3qnh2b45c65plr6ihjbanm7oahnm.apps.googleusercontent.com"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "preview-simulator": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.infosensetechnologies.com/digitalhouse/backend/api",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "457331615949-83vqrhtgb8o67mekio6e7f3hiphiaulc.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "457331615949-80vm3qnh2b45c65plr6ihjbanm7oahnm.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
