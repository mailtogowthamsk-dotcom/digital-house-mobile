{
  "expo": {
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-video",
      "react-native-compressor",
      "./plugins/withGoogleModularHeaders",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": true,
            "edgeToEdgeEnabled": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Digital House needs access to your photos so you can choose images and videos for posts.",
          "savePhotosPermission": "Digital House needs permission to save images and videos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "name": "Digital House",
    "owner": "thisisgowtham",
    "slug": "digital-house",
    "scheme": "digitalhouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Digital House needs access to your photos so you can choose images and videos for posts.",
        "NSPhotoLibraryAddUsageDescription": "Digital House needs permission to save images and videos to your gallery.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["tez", "phonepe", "paytmmp"],
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "bundleIdentifier": "com.anonymous.digital-house"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "android": {
      "backgroundColor": "#F5F6F8",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.thisisgowtham.digitalhouse"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "defefaa3-71d1-495c-98f8-2489497c65ed"
      },
      "googleWebClientId": "457331615949-83vqrhtgb8o67mekio6e7f3hiphiaulc.apps.googleusercontent.com",
      "googleAndroidClientId": "457331615949-80vm3qnh2b45c65plr6ihjbanm7oahnm.apps.googleusercontent.com"
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/defefaa3-71d1-495c-98f8-2489497c65ed",
      "enabled": false
    }
  }
}
