{
  "expo": {
    "plugins": [
      "expo-web-browser",
      "expo-video",
      "react-native-compressor",
      "./plugins/withGoogleModularHeaders",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo_digital_house.png",
          "color": "#0B1220",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Digital House needs access to your photos so you can choose images and videos for posts.",
          "savePhotosPermission": "Digital House needs permission to save images and videos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "name": "Digital House",
    "owner": "thisisgowtham",
    "slug": "digital-house",
    "scheme": "digitalhouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_digital_house.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo_digital_house.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Digital House needs access to your photos so you can choose images and videos for posts.",
        "NSPhotoLibraryAddUsageDescription": "Digital House needs permission to save images and videos to your gallery.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["tez", "phonepe", "paytmmp"]
      },
      "bundleIdentifier": "com.anonymous.digital-house"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_digital_house.png",
        "backgroundColor": "#0B1220"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.thisisgowtham.digitalhouse"
    },
    "web": {
      "favicon": "./assets/logo_digital_house.png"
    },
    "extra": {
      "eas": {
        "projectId": "defefaa3-71d1-495c-98f8-2489497c65ed"
      },
      "googleWebClientId": "634671733122-hrqk0ndpif1jqccvrrahdsdkhg4jugpk.apps.googleusercontent.com",
      "googleIosClientId": "634671733122-af85dglc24jc415afv5o758sb8eqhj23.apps.googleusercontent.com",
      "googleAndroidClientId": "634671733122-mkg5qdh9otdl42c3aet1ttlqau1tfao8.apps.googleusercontent.com"
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/defefaa3-71d1-495c-98f8-2489497c65ed",
      "enabled": false
    }
  }
}
