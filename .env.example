# Production (use www):
EXPO_PUBLIC_API_URL=https://www.infosensetechnologies.com/digitalhouse/backend/api

# Public website origin for legal WebView relative links (kvg-web / konguvettuvagounder.com)
# EXPO_PUBLIC_LEGAL_WEB_ORIGIN=https://konguvettuvagounder.com

# Local dev (your Mac LAN IP, backend npm run dev on port 4000):
# EXPO_PUBLIC_API_URL=http://192.168.0.2:4000/api

# Google Sign-In (Google Cloud project 457331615949)
# Expo Go: Google Sign-In does NOT work (use email OTP or install preview APK).
#
# A) Android OAuth client
#    - Type: Android
#    - Package: com.thisisgowtham.digitalhouse
#    - SHA-1: from `eas credentials -p android` (preview profile)
#
# B) Web OAuth client — no digitalhouse:// in JavaScript origins
#
# C) Rebuild after changes: eas build --platform android --profile preview
#
# Production backend (.env on server) must include GOOGLE_WEB_CLIENT_ID (+ ANDROID/IOS).

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=457331615949-83vqrhtgb8o67mekio6e7f3hiphiaulc.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=457331615949-80vm3qnh2b45c65plr6ihjbanm7oahnm.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
