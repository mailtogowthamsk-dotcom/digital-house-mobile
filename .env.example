
# Backend API URL (must end with /api). Required for login, OTP, and all API calls.
#
# Production (Railway):
#   EXPO_PUBLIC_API_URL=https://digitalhouse-backend-production.up.railway.app/api
#
# Local (device and computer on same Wi‑Fi; use your computer’s IP):
#   EXPO_PUBLIC_API_URL=http://192.168.0.2:4000/api
#
# After changing, restart Expo with cache clear: npx expo start -c
#
# If you see "Cannot reach server": backend must be running; device and Mac on same Wi‑Fi for local IP; or use production URL above.
EXPO_PUBLIC_API_URL=https://digitalhouse-backend-production.up.railway.app/api
