# Production (use www):
EXPO_PUBLIC_API_URL=https://www.infosensetechnologies.com/digitalhouse/backend/api

# Local dev (your Mac LAN IP, backend npm run dev on port 4000):
# EXPO_PUBLIC_API_URL=http://192.168.0.2:4000/api

# Google Sign-In (additional login — from Google Cloud Console OAuth client IDs)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
#
# Expo Go: Google Sign-In does NOT work (use email OTP or install preview APK).
#
# EAS preview APK — Google Cloud Console → Credentials:
#
# A) Android OAuth client (…mkg5qdh9…)
#    - Type: Android (NOT Web)
#    - Package: com.thisisgowtham.digitalhouse
#    - SHA-1: from `eas credentials -p android` (preview profile)
#    - No redirect URIs on this client — only package + SHA-1
#
# B) Web OAuth client (…hrqk0ndp…)
#    - Authorized JavaScript origins: leave EMPTY (or https://your-website.com only)
#      DO NOT put digitalhouse:// here — that causes "Invalid Origin" errors
#    - Authorized redirect URIs: optional for Android APK; if needed, use the
#      "Authorized redirect URIs" box (not origins). Custom schemes may be rejected
#      on Web clients — Android sign-in relies on the Android client above.
#
# C) Rebuild after changes: eas build --platform android --profile preview
#
# Production backend (.env on server) must include GOOGLE_WEB_CLIENT_ID (and ANDROID/IOS if set).

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=634671733122-hrqk0ndpif1jqccvrrahdsdkhg4jugpk.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=634671733122-af85dglc24jc415afv5o758sb8eqhj23.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=634671733122-mkg5qdh9otdl42c3aet1ttlqau1tfao8.apps.googleusercontent.com